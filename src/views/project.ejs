<%- include('partials/header') %>
    <main>
        <h1><%= project.title %></h1>
        <p><strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><%= project.description %></p>

        <h2>Categories</h2>
        <% if (categories.length > 0) { %>
            <ul class="category-tags">
                <% categories.forEach(category => { %>
                    <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>This project has no categories.</p>
        <% } %>

        <p><a href="/projects">&larr; Back to all projects</a></p>
    </main>
<%- include('partials/footer') %>