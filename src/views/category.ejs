<%- include('partials/header') %>
    <main>
        <h1><%= category.name %></h1>

        <h2>Service Projects</h2>

        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <%= new Date(project.date).toLocaleDateString() %>:
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>